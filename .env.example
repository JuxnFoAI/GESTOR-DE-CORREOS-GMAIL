# Credenciales OAuth de tu proyecto en Google Cloud. Nunca las subas al repositorio.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Refresh token de tu cuenta con el alcance https://www.googleapis.com/auth/gmail.modify
GMAIL_REFRESH_TOKEN=

# Ventana de correos que se revisa en cada ejecución, en horas. Por defecto 6.
LOOKBACK_HOURS=

# "true" para revisar y avisar sin mover nada a la papelera.
DRY_RUN=
